# Server
PORT=3847
SESSION_SECRET=change-me-to-a-long-random-string

# Demo borrower login (single user)
DEMO_BORROWER_EMAIL=maria.rodriguez@example.com
DEMO_BORROWER_PASSWORD=demo1234

# -----------------------------------------------------------------------------
# QuickBooks Online — payment processor ONLY
# Portal Pay posts a Journal Entry (Bank debit / Note Receivable principal /
# Interest Income). QBO is NOT linked to amortization and does NOT issue invoices.
# Leave blank → local payments still work; receipt shows "Pending QuickBooks sync".
# Do not invent or commit real client secrets.
# -----------------------------------------------------------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must match Intuit Developer app Redirect URI exactly
QBO_REDIRECT_URI=http://localhost:3847/oauth/callback
# sandbox (default) or production — must match the Intuit keys + company
QBO_ENVIRONMENT=sandbox

# Optional if you already have tokens (OAuth Playground). Prefer Connect at
# /settings/qbo which writes data/qbo-tokens.json (gitignored).
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
QBO_ACCESS_TOKEN=

# Chart of Accounts Ids in the SAME company as realmId
# Debit: Bank or Undeposited Funds
QBO_BANK_DEPOSIT_ACCOUNT_ID=
# Credit: Note Receivable (Other Current Asset) — principal
QBO_PRINCIPAL_INCOME_OR_ASSET_ACCOUNT_ID=
# Credit: Interest Income — interest
QBO_INTEREST_INCOME_ACCOUNT_ID=
